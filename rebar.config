{minimum_otp_vsn, "22"}.

{erl_opts, [
    debug_info,
    warn_obsolete_guard,
    warn_shadow_vars,
    {platform_define, "^(R|1|20|21|22|23|24|25|26|27)", 'BEFORE_OTP_28'}
]}.

{deps, [
    {leo_commons, {git, "https://github.com/leo-project/leo_commons.git", {tag, "1.3.0"}}}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        unmatched_returns,
        error_handling,
        unknown
    ]},
    {plt_extra_apps, [leo_commons]}
]}.

{cover_enabled, true}.
{cover_opts, [verbose]}.

{profiles, [
    {test, [
        {erl_opts, [debug_info, nowarn_export_all]},
        {deps, []}
    ]}
]}.

{project_plugins, [
    rebar3_hex,
    rebar3_lint
]}.
